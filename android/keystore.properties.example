# Release 签名配置模板 —— 复制成 android/keystore.properties 后填自己的值。
#
# ⚠️ keystore.properties 已被 .gitignore 忽略，**不要**把真实口令提交进仓库
#    （v1.0.0 曾把 storePassword/keyPassword 明文写在 android/app/build.gradle 里，
#     见 docs/ITERATION-REVIEW.md REV-04）。
#
# storeFile 的路径以 android/app/build.gradle 所在目录（android/app）为基准。
# 把 keystore 放在仓库根目录时就是 ../../release.keystore。
#
# 生成密钥（只做一次，务必把 keystore 与口令另存到仓库之外的安全位置）：
#   keytool -genkeypair -v -keystore release.keystore -alias home-steward \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# 若 CI 里不便放文件，可改用同名环境变量：
#   HOME_STEWARD_KEYSTORE / HOME_STEWARD_STORE_PASSWORD /
#   HOME_STEWARD_KEY_ALIAS / HOME_STEWARD_KEY_PASSWORD

storeFile=../../release.keystore
storePassword=change-me
keyAlias=home-steward
keyPassword=change-me
