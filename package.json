{
  "name": "home-steward",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "家庭物资管家 · 本地优先的移动端 App（无服务器 / 无账号 / 数据全在本机）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --port 4173",
    "icons": "node scripts/gen-icons.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "dexie": "^4.4.6",
    "pinia": "^4.0.3",
    "vant": "^4.9.15",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-vue": "^6.0.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
